    },
    "reportedValue": {
     "type": [
      "string",
      "null"
     ]
    },
    "arms": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/arm"
     }
    }
   },
   "required": [
    "key",
    "label",
    "unit",
    "endpointType",
    "population",
    "status",
    "hr",
    "reportedValue",
    "arms"
   ],
   "additionalProperties": false
