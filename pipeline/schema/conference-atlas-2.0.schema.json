    },
    "level": {
     "type": [
      "number",
      "null"
     ]
    },
    "p": {
     "$ref": "#/$defs/pValue"
    }
   },
   "required": [
    "value",
    "ci",
    "level",
    "p"
   ],
   "additionalProperties": false
