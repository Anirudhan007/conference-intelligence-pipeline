    "code",
    "presentationId",
    "drug",
    "trial",
    "targets",
    "modality",
    "disease",
    "setting",
    "phase",
    "design",
    "studyN",
    "cutoff",
    "followUp",
    "analysis",
    "primaryEndpoint",
    "readoutType",
    "metrics",
    "safety",
